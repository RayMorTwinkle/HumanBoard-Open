{
  "name": "humanboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun run build && bun run serve",
    "serve": "bun scripts/serve.ts",
    "build": "bun run --filter @humanboard/canvas-ui build && bun run --filter @humanboard/local-studio build",
    "human": "bun scripts/human.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "format": "prettier --write \"packages/**/*.{ts,tsx}\" \"apps/**/*.ts\" \"scripts/*.{ts,mjs}\"",
    "studio": "bun run --filter @humanboard/local-studio start"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  }
}
