{
  "name": "humanboard-open",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "mcp": "node src/mcp.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test test/*.test.mjs",
    "studio": "sh studio/scripts/start-studio.sh",
    "typecheck": "cd studio && bun run typecheck",
    "build": "cd studio && bun run build",
    "check": "npm test && cd studio && bun install --frozen-lockfile && bun run check"
  }
}
